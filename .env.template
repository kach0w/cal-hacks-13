# Copy to .env (gitignored) and fill in what you have: cp .env.template .env
# Every key is optional. Without one, that integration is off and Recall works as before.

# Claude: "Ask about the day" for the care partner (recall/care.py). console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# RECALL_CARE_MODEL=claude-sonnet-5-5

# Cartesia: the spoken voice for answers and directions (recall/tts.py). play.cartesia.ai -> API Keys
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=        # another voice from play.cartesia.ai/voices

# Tiger Data: the database copy of the memory (recall/db.py). The connection string from the
# service's config file in Tiger Console, e.g. postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
DATABASE_URL=

# Moss: understanding vague questions (recall/moss_search.py). portal.usemoss.dev -> your project
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# MOSS_MIN_SCORE=0.4
